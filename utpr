#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
VERSION="0.1.0"
UTPR_CREATED_BY="utpr"

# ---------------------------------------------------------------------------
# Error handling
# ---------------------------------------------------------------------------
die() { gum_error "$@"; exit 1; }

git_spin() {
  local title="$1"
  shift
  local output
  if ! output="$(gum spin --title "$title" --show-error -- "$@" 2>&1)"; then
    if [[ -n "$output" ]]; then
      printf '%s\n' "$output" >&2
    fi
    die "${title%...} failed."
  fi
}

# ---------------------------------------------------------------------------
# check_dependencies()
# ---------------------------------------------------------------------------
check_dependencies() {
  local missing=0
  local os
  os="$(uname -s)"

  _install_hint() {
    local cmd="$1"
    if [ "${os}" = "Darwin" ] && command -v brew &>/dev/null; then
      echo "  brew install ${cmd}"
    elif command -v apt-get &>/dev/null; then
      echo "  sudo apt-get install ${cmd}"
    elif command -v dnf &>/dev/null; then
      echo "  sudo dnf install ${cmd}"
    else
      echo "  Please install ${cmd} via your system package manager."
    fi
  }

  for dep in git gh jq gum; do
    if ! command -v "${dep}" &>/dev/null; then
      echo "Missing dependency: ${dep}" >&2
      echo "Install with:" >&2
      _install_hint "${dep}" >&2
      missing=1
    fi
  done

  if [ "${missing}" -eq 1 ]; then
    exit 1
  fi

  if ! gh auth status &>/dev/null; then
    echo "gh is not authenticated. Run: gh auth login" >&2
    exit 1
  fi
}

# ---------------------------------------------------------------------------
# Gum output helpers (all write to stderr)
# ---------------------------------------------------------------------------
gum_info()    { gum style --foreground 4 "ℹ $*" >&2; }
gum_warn()    { gum style --foreground 3 "⚠ $*" >&2; }
gum_error()   { gum style --foreground 1 "✖ $*" >&2; }
gum_success() { gum style --foreground 2 "✔ $*" >&2; }

# ---------------------------------------------------------------------------
# Input validation
# ---------------------------------------------------------------------------
validate_branch_name() {
  local branch="$1"
  if [[ "$branch" == -* ]]; then
    die "Invalid branch name (cannot start with '-'): ${branch}"
  fi
  if ! git check-ref-format --allow-onelevel "refs/heads/${branch}" 2>/dev/null; then
    die "Invalid branch name: ${branch}"
  fi
}

validate_pr_number() {
  local num="$1"
  if [[ ! "$num" =~ ^[0-9]+$ ]]; then
    die "Invalid PR number: ${num}"
  fi
}

parse_pr_number_from_choice() {
  local choice="$1"
  local plain num
  # Strip ANSI SGR escape sequences before parsing so styled lines parse correctly
  plain="$(printf '%s' "$choice" | sed $'s/\033\\[[0-9;]*m//g')"
  if [[ "$plain" =~ ^#([0-9]+)([[:space:]]|$) ]]; then
    num="${BASH_REMATCH[1]}"
  else
    die "Could not parse PR number from selection: ${choice}"
  fi
  validate_pr_number "$num"
  printf '%s\n' "$num"
}

# ---------------------------------------------------------------------------
# Git utilities
# ---------------------------------------------------------------------------
get_default_branch() {
  local remote="${1:-origin}"
  local branch
  branch="$(git symbolic-ref "refs/remotes/${remote}/HEAD" 2>/dev/null | sed "s|refs/remotes/${remote}/||")" || true
  if [[ -n "$branch" ]]; then
    printf '%s\n' "$branch"
    return 0
  fi

  if git show-ref --verify --quiet refs/heads/main; then
    printf 'main\n'
    return 0
  fi
  if git show-ref --verify --quiet refs/heads/master; then
    printf 'master\n'
    return 0
  fi

  if git show-ref --verify --quiet "refs/remotes/${remote}/main"; then
    printf 'main\n'
    return 0
  fi
  if git show-ref --verify --quiet "refs/remotes/${remote}/master"; then
    printf 'master\n'
    return 0
  fi

  return 1
}

get_current_branch() {
  git rev-parse --abbrev-ref HEAD
}

is_on_default_branch() {
  local current default
  current="$(get_current_branch)"
  default="$(get_default_branch)"
  [[ "$current" == "$default" ]]
}

has_uncommitted_changes() {
  local status
  status="$(git status --porcelain --untracked-files=no 2>/dev/null)"
  [[ -n "$status" ]]
}

ensure_git_repo() {
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    die "Not inside a git repository (or worktree). Run utpr from a repository checkout."
  fi
}

get_branch_worktree_path() {
  local branch="$1"
  git worktree list --porcelain 2>/dev/null | awk -v ref="refs/heads/${branch}" '
    $1 == "worktree" { count++; if (count > 1) wt = $2 }
    $1 == "branch" && $2 == ref && count > 1 { print wt; exit }
  ' || true
}

switch_to_branch() {
  local branch="$1"
  local output path
  if ! output="$(git switch "$branch" 2>&1)"; then
    path="$(get_branch_worktree_path "$branch")"
    if [[ -n "$path" ]]; then
      die "Branch '${branch}' is checked out in another worktree: ${path}"
    fi
    if [[ -n "$output" ]]; then
      printf '%s\n' "$output" >&2
    fi
    die "Failed to switch to branch '${branch}'."
  fi
}

challenge_local_branch_delete() {
  local branch="$1"
  local tracking
  tracking="$(git rev-parse --abbrev-ref --symbolic-full-name "${branch}@{u}" 2>/dev/null || true)"

  if [[ -z "$tracking" ]]; then
    gum_warn "Local branch '${branch}' has no associated remote branch."
    gum_info "If we delete '${branch}', any work that exists only on this branch may be hard for you to recover."
    if ! gum confirm "Proceed anyway?" --default=false; then
      gum_error "Cancelling."
      exit 1
    fi
    return 0
  fi

  local unpushed
  unpushed="$(git log "${tracking}..${branch}" --oneline 2>/dev/null)" || true
  if [[ -n "$unpushed" ]]; then
    gum_warn "Local branch '${branch}' has 1 or more commits that have not been pushed to '${tracking}'."
    gum_info "If we delete '${branch}', this work may be hard for you to recover."
    if ! gum confirm "Proceed anyway?" --default=false; then
      gum_error "Cancelling."
      exit 1
    fi
  fi
}

delete_local_branch() {
  local branch="$1"
  local output path
  if ! output="$(git branch -D -- "$branch" 2>&1)"; then
    path="$(get_branch_worktree_path "$branch")"
    if [[ -n "$path" ]]; then
      die "Cannot delete '${branch}' because it is checked out in another worktree: ${path}"
    fi
    if [[ -n "$output" ]]; then
      printf '%s\n' "$output" >&2
    fi
    die "Failed to delete local branch '${branch}'."
  fi
}

has_unpushed_commits() {
  local tracking
  tracking="$(get_tracking_branch)"
  if [[ -z "$tracking" ]]; then
    # No tracking branch means everything is unpushed
    return 0
  fi

  local unpushed
  unpushed="$(git log '@{u}..HEAD' --oneline 2>/dev/null)" || return 1
  [[ -n "$unpushed" ]]
}

get_tracking_branch() {
  git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true
}

challenge_uncommitted_changes() {
  if ! has_uncommitted_changes; then
    return 0
  fi

  gum_warn "There are uncommited changes, which may cause problems or be lost when we push, pull, switch or compare branches."
  if ! gum confirm "Do you want to proceed anyway?" --default=false; then
    exit 1
  fi
}

challenge_unpushed_commits() {
  if ! has_unpushed_commits; then
    return 0
  fi

  gum_warn "You have unpushed commits."
  if ! gum confirm "You have unpushed commits. Continue?" --default=false; then
    exit 1
  fi
}

challenge_branch_behind_remote() {
  local tracking
  tracking="$(get_tracking_branch)"
  if [[ -z "$tracking" ]]; then
    return 0
  fi

  local behind
  behind="$(git rev-list --count "HEAD..@{u}" 2>/dev/null || echo 0)"
  if [[ "$behind" -gt 0 ]]; then
    gum_warn "Local branch is ${behind} commit(s) behind '${tracking}'."
    gum_info "You may want to run 'utpr pull' to update before switching away."
    if ! gum confirm "Proceed anyway?" --default=false; then
      gum_error "Cancelling."
      exit 1
    fi
  fi
}

# ---------------------------------------------------------------------------
# Worktree utilities
# ---------------------------------------------------------------------------
get_worktree_dir() {
  local branch="$1"
  local repo_root repo_name parent_dir
  repo_root="$(git rev-parse --show-toplevel)"
  repo_name="$(basename "$repo_root")"
  parent_dir="$(dirname "$repo_root")"
  printf '%s\n' "${parent_dir}/${repo_name}.worktrees/${branch}"
}

is_in_worktree() {
  local git_dir git_common_dir
  git_dir="$(git rev-parse --git-dir 2>/dev/null)"
  git_common_dir="$(git rev-parse --git-common-dir 2>/dev/null)"
  [[ "$git_dir" != "$git_common_dir" ]]
}

get_main_repo_root() {
  local git_common_dir
  git_common_dir="$(git rev-parse --git-common-dir 2>/dev/null)"
  # git-common-dir returns path to .git; parent is the repo root
  printf '%s\n' "$(cd "$git_common_dir/.." && pwd)"
}

auto_detect_editor() {
  # Explicit override via env var
  if [[ -n "${UTPR_EDITOR:-}" ]]; then
    printf '%s\n' "$UTPR_EDITOR"; return
  fi

  # Check for Positron first, since it is based on VS Code
  if [[ "${POSITRON:-}" == "1" ]]; then
    printf 'positron\n'; return
  fi

  # Check for Cursor (VS Code fork)
  if [[ -n "${CURSOR_TRACE_ID:-}" || -n "${CURSOR_SESSION_ID:-}" ]]; then
    printf 'cursor\n'; return
  fi

  # Check for Windsurf (Codeium's VS Code fork)
  if [[ -n "${WINDSURF:-}" || -n "${CODEIUM_WIND_SURF:-}" ]]; then
    printf 'windsurf\n'; return
  fi

  # Check for Zed
  if [[ -n "${ZED_SESSION:-}" || "${TERM_PROGRAM:-}" == "zed" ]]; then
    printf 'zed\n'; return
  fi

  # Check TERM_PROGRAM (set by many terminal-integrated editors)
  case "${TERM_PROGRAM:-}" in
    vscode)
      if [[ "${VSCODE_GIT_IPC_HANDLE:-}" == *"Code - Insiders"* ]]; then
        printf 'code-insiders\n'
      else
        printf 'code\n'
      fi
      return
      ;;
  esac

  # Fallback: check for VS Code via other env vars
  if [[ -n "${VSCODE_GIT_IPC_HANDLE:-}" || -n "${VSCODE_PID:-}" ]]; then
    if [[ "${VSCODE_GIT_IPC_HANDLE:-}" == *"Code - Insiders"* ]]; then
      printf 'code-insiders\n'
    else
      printf 'code\n'
    fi
    return
  fi

  # No editor detected
  printf '\n'
}

open_in_editor() {
  local editor_spec="$1" target_path="$2"
  local -a editor_cmd=()
  read -r -a editor_cmd <<<"$editor_spec"

  if [[ ${#editor_cmd[@]} -eq 0 ]]; then
    gum_warn "No editor command provided."
    return 1
  fi

  if ! command -v "${editor_cmd[0]}" &>/dev/null; then
    gum_warn "Editor command '${editor_cmd[0]}' not found; skipping open."
    return 1
  fi

  if "${editor_cmd[@]}" "$target_path"; then
    gum_success "Opened in ${editor_spec}."
    return 0
  fi

  gum_warn "Failed to open in ${editor_spec}."
  return 1
}

symlink_worktree_dirs() {
  local repo_root="$1" worktree_dir="$2"
  local available=()

  local symlink_dirs="${UTPR_SYMLINK_DIRS:-_dev,.claude}"
  local item
  IFS=',' read -ra _dirs <<<"$symlink_dirs"
  for item in "${_dirs[@]}"; do
    item="${item## }" # trim leading space
    item="${item%% }" # trim trailing space
    [[ -n "$item" ]] && [[ -d "${repo_root}/${item}" ]] && available+=("$item")
  done

  if [[ ${#available[@]} -eq 0 ]]; then
    return 0
  fi

  local selected
  selected="$(printf '%s\n' "${available[@]}" | gum choose --no-limit --header "Symlink into worktree:" --selected "$(IFS=,; printf '%s' "${available[*]}")")" || true

  if [[ -z "$selected" ]]; then
    return 0
  fi

  while IFS= read -r item; do
    [[ -z "$item" ]] && continue
    if [[ "$item" == ".claude" ]]; then
      if [[ ! -d "${worktree_dir}/.claude" ]]; then
        # .claude not tracked in git — symlink the entire folder
        if ln -s "${repo_root}/.claude" "${worktree_dir}/.claude"; then
          gum_success "Symlinked .claude"
        else
          gum_warn "Failed to symlink .claude."
        fi
      else
        # .claude tracked in git — only symlink settings.local.json
        if [[ -f "${repo_root}/.claude/settings.local.json" ]] && [[ ! -f "${worktree_dir}/.claude/settings.local.json" ]]; then
          if ln -s "${repo_root}/.claude/settings.local.json" "${worktree_dir}/.claude/settings.local.json"; then
            gum_success "Symlinked .claude/settings.local.json"
          else
            gum_warn "Failed to symlink .claude/settings.local.json."
          fi
        fi
      fi
    else
      if [[ ! -e "${worktree_dir}/${item}" ]]; then
        if ln -s "${repo_root}/${item}" "${worktree_dir}/${item}"; then
          gum_success "Symlinked ${item}"
        else
          gum_warn "Failed to symlink ${item}."
        fi
      fi
    fi
  done <<<"$selected"
}

run_worktree_setup() {
  local worktree_dir="$1"

  if [[ -f "${worktree_dir}/package.json" ]] && command -v npm &>/dev/null; then
    if ! gum spin --title "Running npm install..." --show-error -- npm install --prefix "$worktree_dir" >&2; then
      gum_warn "npm install failed (non-fatal)."
    fi
  fi

  if [[ -f "${worktree_dir}/pyproject.toml" ]] && command -v uv &>/dev/null; then
    if ! gum spin --title "Running uv sync..." --show-error -- uv sync --all-groups --directory "$worktree_dir" >&2; then
      gum_warn "uv sync failed (non-fatal)."
    fi
  fi

  if [[ -f "${worktree_dir}/Makefile" ]] && grep -q '^setup:' "${worktree_dir}/Makefile"; then
    if ! gum spin --title "Running make setup..." --show-error -- make -C "$worktree_dir" setup >&2; then
      gum_warn "make setup failed (non-fatal)."
    fi
  fi
}

remove_worktree() {
  local branch="$1"
  local wt_path
  wt_path="$(get_branch_worktree_path "$branch")"

  if [[ -z "$wt_path" ]]; then
    return 0
  fi

  gum_info "Branch '${branch}' has a worktree at: ${wt_path}"
  if ! gum confirm "Remove worktree?"; then
    return 0
  fi

  if ! git worktree remove "$wt_path" 2>/dev/null; then
    gum_warn "Worktree has uncommitted changes."
    if gum confirm "Force remove worktree?" --default=false; then
      git worktree remove --force "$wt_path"
    else
      die "Cannot proceed without removing the worktree."
    fi
  fi

  gum_success "Removed worktree for '${branch}'."
}

offer_worktree_navigation() {
  local target_path="$1"
  local editor
  editor="$(auto_detect_editor)"

  local choice
  if [[ -n "$editor" ]]; then
    choice="$(gum choose --header "Worktree: ${target_path}" \
      "Open in ${editor}" "Show path" "Do nothing")" || true
  else
    choice="$(gum choose --header "Worktree: ${target_path}" \
      "Show path" "Open in editor..." "Do nothing")" || true
  fi

  case "$choice" in
    "Open in editor..."*)
      _pick_and_open_editor "$target_path"
      ;;
    "Open in "*)
      # editor was detected — use the variable directly, not the display string
      open_in_editor "$editor" "$target_path" || true
      ;;
    "Show path")
      gum_info "cd \"${target_path}\""
      ;;
  esac
}

_pick_and_open_editor() {
  local target_path="$1"
  local editors=()
  local cmd
  for cmd in code code-insiders cursor positron windsurf zed; do
    command -v "$cmd" &>/dev/null && editors+=("$cmd")
  done
  editors+=("Custom...")

  local editor_choice
  editor_choice="$(printf '%s\n' "${editors[@]}" | gum choose --header "Select editor:")" || true
  if [[ "$editor_choice" == "Custom..." ]]; then
    editor_choice="$(gum input --placeholder "editor command (optional args)")" || true
  fi
  if [[ -n "$editor_choice" ]]; then
    open_in_editor "$editor_choice" "$target_path" || true
  fi
}

# ---------------------------------------------------------------------------
# Remote config detection
# ---------------------------------------------------------------------------
GH_LOGIN=""
REMOTE_CONFIG=""
SOURCE_REMOTE=""
PUSH_REMOTE=""
DEFAULT_BRANCH=""

get_gh_login() {
  if [[ -z "$GH_LOGIN" ]]; then
    GH_LOGIN="$(gh api user --jq '.login' 2>/dev/null || true)"
  fi
  printf '%s\n' "$GH_LOGIN"
}

require_remote_config() {
  if [[ -z "$REMOTE_CONFIG" ]]; then
    die "Internal error: remote config not initialized."
  fi
}

detect_remote_config() {
  if [[ -n "$REMOTE_CONFIG" ]]; then
    return 0
  fi

  local origin_url owner_repo fallback_remote
  origin_url="$(git remote get-url origin 2>/dev/null)" || {
    fallback_remote="$(git remote | head -n 1 || true)"
    if [[ -z "$fallback_remote" ]]; then
      die "No git remotes configured. Add a remote before using utpr."
    fi
    gum_warn "No 'origin' remote found. Using '${fallback_remote}'."
    REMOTE_CONFIG="ours"
    SOURCE_REMOTE="$fallback_remote"
    PUSH_REMOTE="$fallback_remote"
    DEFAULT_BRANCH="$(get_default_branch "$SOURCE_REMOTE")" || DEFAULT_BRANCH="main"
    return 0
  }
  owner_repo="$(parse_repo_spec "$origin_url")"

  local api_output
  api_output="$(
    gh api "repos/${owner_repo}" \
      --jq '[.fork, .permissions.push, (.parent.full_name // "")] | @tsv' \
      2>/dev/null
  )" || api_output=""

  if [[ -z "$api_output" ]]; then
    gum_warn "Could not reach GitHub API. Inferring remote config from local remotes."
    if git remote get-url upstream &>/dev/null; then
      REMOTE_CONFIG="fork"
      SOURCE_REMOTE="upstream"
      PUSH_REMOTE="origin"
    else
      REMOTE_CONFIG="ours"
      SOURCE_REMOTE="origin"
      PUSH_REMOTE="origin"
    fi
    DEFAULT_BRANCH="$(get_default_branch "$SOURCE_REMOTE")" || DEFAULT_BRANCH="main"
    return 0
  fi

  local is_fork can_push parent_full_name
  IFS=$'\t' read -r is_fork can_push parent_full_name <<<"$api_output"

  if [[ "$is_fork" == "false" && "$can_push" == "true" ]]; then
    REMOTE_CONFIG="ours"
    SOURCE_REMOTE="origin"
    PUSH_REMOTE="origin"
    DEFAULT_BRANCH="$(get_default_branch "$SOURCE_REMOTE")" || DEFAULT_BRANCH="main"
    return 0
  fi

  if [[ "$is_fork" == "true" ]]; then
    REMOTE_CONFIG="fork"
    PUSH_REMOTE="origin"

    if git remote get-url upstream &>/dev/null; then
      SOURCE_REMOTE="upstream"
    else
      if [[ -n "$parent_full_name" ]]; then
        if gum confirm "Add 'upstream' remote for '${parent_full_name}'?"; then
          git remote add upstream "https://github.com/${parent_full_name}.git"
          SOURCE_REMOTE="upstream"
        else
          gum_warn "Using origin as source remote (no upstream configured)."
          SOURCE_REMOTE="origin"
        fi
      else
        gum_warn "Fork detected but could not determine parent repo. Using origin as source."
        SOURCE_REMOTE="origin"
      fi
    fi
    DEFAULT_BRANCH="$(get_default_branch "$SOURCE_REMOTE")" || DEFAULT_BRANCH="main"
    return 0
  fi

  gum_warn "Could not determine remote config. Falling back to 'ours'."
  REMOTE_CONFIG="ours"
  SOURCE_REMOTE="origin"
  PUSH_REMOTE="origin"
  DEFAULT_BRANCH="$(get_default_branch "$SOURCE_REMOTE")" || DEFAULT_BRANCH="main"
}

parse_repo_spec() {
  local url="$1"
  local result

  url="${url%.git}"

  # SSH shorthand: git@github.com:owner/repo
  if [[ "$url" == git@*:* ]]; then
    result="${url##*:}"
  # HTTPS, HTTP, or ssh:// scheme: extract path after host
  elif [[ "$url" == https://* || "$url" == http://* || "$url" == ssh://* ]]; then
    result="${url#*://}"
    result="${result#*/}"
  else
    die "Unrecognized remote URL format: ${url}"
  fi

  # Extract the last two path segments as owner/repo
  # Handles GHE with path prefixes: https://ghe.corp.com/prefix/owner/repo
  local owner repo
  repo="${result##*/}"
  result="${result%/*}"
  owner="${result##*/}"

  if [[ -z "$owner" || -z "$repo" ]]; then
    die "Could not parse owner/repo from remote URL: ${url}"
  fi

  printf '%s/%s\n' "$owner" "$repo"
}

open_url() {
  local url="$1"

  if [[ "$(uname -s)" == "Darwin" ]]; then
    open "$url"
    return
  fi

  if grep -qi microsoft /proc/version 2>/dev/null; then
    if command -v wslview &>/dev/null; then
      wslview "$url"
    else
      cmd.exe /c start "$url" 2>/dev/null || true
    fi
    return
  fi

  if command -v xdg-open &>/dev/null; then
    xdg-open "$url"
    return
  fi

  gum_warn "Could not find a URL opener for this platform."
}

# ---------------------------------------------------------------------------
# Help system
# ---------------------------------------------------------------------------
show_help() {
  gum style \
    --border rounded \
    --border-foreground 4 \
    --padding "1 2" \
    --margin "0 0" \
    "$(gum style --bold --foreground 4 "utpr") $(gum style --faint "v${VERSION}")" >&2

  gum style --bold "Usage:" >&2
  gum style "  utpr <command> [options]" >&2
  echo >&2

  gum style --bold "Commands:" >&2
  gum style \
    "  $(gum style --foreground 4 "init")        Create a new PR branch (--worktree)" \
    "  $(gum style --foreground 4 "pause")       Switch back to default branch" \
    "  $(gum style --foreground 4 "resume")      Resume work on a PR branch" \
    "  $(gum style --foreground 4 "fetch")       Fetch a PR from GitHub" \
    "  $(gum style --foreground 4 "push")        Push branch and create/update PR" \
    "  $(gum style --foreground 4 "pull")        Pull latest changes" \
    "  $(gum style --foreground 4 "merge-main")  Merge default branch into current branch" \
    "  $(gum style --foreground 4 "forget")      Abandon and delete a local PR branch" \
    "  $(gum style --foreground 4 "finish")      Clean up after a merged PR" \
    "  $(gum style --foreground 4 "view")        View PR details and comments" >&2
  echo >&2

  gum style --faint "Run 'utpr <command> --help' for command-specific help." >&2
}

show_command_help() {
  local cmd="$1"

  case "${cmd}" in
    init)
      gum style --bold "utpr init [--worktree] [--base <ref>] <branch>" >&2
      echo >&2
      gum style "Create a new PR branch." >&2
      echo >&2
      gum style --bold "Arguments:" >&2
      gum style "  <branch>  Name of the new branch to create" >&2
      echo >&2
      gum style --bold "Options:" >&2
      gum style "  --worktree     Create branch in a new git worktree" >&2
      gum style "  --base <ref>   Base branch or ref to create from (default: current branch)" >&2
      echo >&2
      gum style --bold "Environment:" >&2
      gum style "  UTPR_EDITOR        Editor to open the worktree in (default: auto-detected)" >&2
      gum style "  UTPR_SYMLINK_DIRS  Comma-separated dirs to symlink into worktrees (default: _dev,.claude)" >&2
      ;;
    pause)
      gum style --bold "utpr pause" >&2
      echo >&2
      gum style "Switch back to the default branch, stashing or committing any in-progress work." >&2
      ;;
    resume)
      gum style --bold "utpr resume [<branch>]" >&2
      echo >&2
      gum style "Resume work on a PR branch." >&2
      echo >&2
      gum style --bold "Arguments:" >&2
      gum style "  <branch>  Branch to resume (interactive selection if omitted)" >&2
      ;;
    fetch)
      gum style --bold "utpr fetch [--worktree] [<pr>]" >&2
      echo >&2
      gum style "Fetch a PR from GitHub and check it out locally." >&2
      echo >&2
      gum style --bold "Arguments:" >&2
      gum style "  <pr>  PR number to fetch (interactive selection if omitted)" >&2
      echo >&2
      gum style --bold "Options:" >&2
      gum style "  --worktree  Check out the PR in a new git worktree" >&2
      echo >&2
      gum style --bold "Environment:" >&2
      gum style "  UTPR_EDITOR        Editor to open the worktree in (default: auto-detected)" >&2
      gum style "  UTPR_SYMLINK_DIRS  Comma-separated dirs to symlink into worktrees (default: _dev,.claude)" >&2
      ;;
    push)
      gum style --bold "utpr push [--edit=browser|terminal]" >&2
      echo >&2
      gum style "Push the current branch and create or update the associated PR." >&2
      echo >&2
      gum style "On first push, creates a new PR. Default prompts interactively in the" >&2
      gum style "terminal. Use --edit=browser to open the GitHub compare page instead." >&2
      echo >&2
      gum style --bold "Options:" >&2
      gum style "  --edit=terminal  Create PR interactively in the terminal (default)" >&2
      gum style "  --edit=browser   Create PR in browser" >&2
      ;;
    pull)
      gum style --bold "utpr pull" >&2
      echo >&2
      gum style "Pull the latest changes for the current branch from GitHub." >&2
      ;;
    merge-main)
      gum style --bold "utpr merge-main" >&2
      echo >&2
      gum style "Merge the default branch into the current PR branch to stay up to date." >&2
      ;;
    forget)
      gum style --bold "utpr forget [<branch>]" >&2
      echo >&2
      gum style "Abandon a local PR branch and delete it." >&2
      gum style "Automatically removes any associated worktree." >&2
      echo >&2
      gum style --bold "Arguments:" >&2
      gum style "  <branch>  Branch to forget (defaults to current branch, or interactive picker on default branch)" >&2
      ;;
    finish)
      gum style --bold "utpr finish [<pr>]" >&2
      echo >&2
      gum style "Clean up a local branch after its PR has been merged." >&2
      gum style "Automatically removes any associated worktree." >&2
      echo >&2
      gum style --bold "Arguments:" >&2
      gum style "  <pr>  PR number to finish (defaults to current branch's PR)" >&2
      ;;
    view)
      gum style --bold "utpr view [--web|-w] [--summary] [<pr>]" >&2
      echo >&2
      gum style "View a PR. Shows full details with comments by default." >&2
      echo >&2
      gum style --bold "Arguments:" >&2
      gum style "  <pr>  PR number to view (defaults to current branch's PR)" >&2
      echo >&2
      gum style --bold "Options:" >&2
      gum style "  --web, -w  Open the PR in the browser" >&2
      gum style "  --summary  Show a brief summary formatted as markdown (no comments)" >&2
      ;;
    *)
      echo >&2
      show_help
      die "Unknown command: ${cmd}"
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Command functions
# ---------------------------------------------------------------------------
cmd_init() {
  local branch="" use_worktree=false base_ref=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --worktree) use_worktree=true; shift ;;
      --base)
        if [[ -z "${2:-}" ]]; then
          die "--base requires a branch or ref argument."
        fi
        base_ref="$2"; shift 2
        ;;
      *) branch="$1"; shift ;;
    esac
  done

  if [[ -z "$branch" ]]; then
    show_command_help init
    die "Branch name required."
  fi

  validate_branch_name "$branch"
  detect_remote_config

  if git show-ref --verify --quiet "refs/heads/${branch}"; then
    local wt_path
    wt_path="$(get_branch_worktree_path "$branch")"

    if [[ -n "$wt_path" ]]; then
      gum_info "Branch '${branch}' already has a worktree."
      offer_worktree_navigation "$wt_path"
      return
    fi

    if [[ "$use_worktree" == true ]]; then
      gum_info "Creating worktree for existing branch '${branch}'."
      _init_worktree "$branch"
      return
    fi

    gum_info "Branch '${branch}' already exists locally. Resuming."
    cmd_resume "$branch"
    return
  fi

  # Default base to current branch
  if [[ -z "$base_ref" ]]; then
    base_ref="$(get_current_branch)"
  fi

  # Fetch and update the base ref from upstream
  if [[ "$base_ref" == */* ]]; then
    # Remote-tracking ref (e.g. origin/main) — fetch from that remote
    local fetch_remote="${base_ref%%/*}"
    local fetch_branch="${base_ref#*/}"
    git_spin "Fetching ${base_ref}..." \
      git fetch "$fetch_remote" "$fetch_branch"
  else
    # Local branch — find its upstream and fetch
    local base_upstream=""
    base_upstream="$(git rev-parse --abbrev-ref "${base_ref}@{upstream}" 2>/dev/null)" || true

    if [[ -n "$base_upstream" ]]; then
      local fetch_remote="${base_upstream%%/*}"
      local fetch_branch="${base_upstream#*/}"
      git_spin "Fetching latest ${base_ref}..." \
        git fetch "$fetch_remote" "$fetch_branch"

      if [[ "$(get_current_branch)" == "$base_ref" ]]; then
        # On the base branch — pull to update working tree
        git_spin "Pulling ${base_ref}..." \
          git pull "$fetch_remote" "$fetch_branch"
      else
        # Not on the base branch — fast-forward the local ref if possible
        local local_sha remote_sha
        local_sha="$(git rev-parse "$base_ref")"
        remote_sha="$(git rev-parse "$base_upstream")"
        if [[ "$local_sha" != "$remote_sha" ]]; then
          local merge_base
          merge_base="$(git merge-base "$base_ref" "$base_upstream")"
          if [[ "$merge_base" == "$local_sha" ]]; then
            git update-ref "refs/heads/$base_ref" "$remote_sha"
            gum_success "Fast-forwarded '${base_ref}' to '${base_upstream}'."
          else
            gum_warn "'${base_ref}' has diverged from '${base_upstream}'."
            gum_info "You may want to update '${base_ref}' manually before continuing."
          fi
        fi
      fi
    fi
  fi

  if [[ "$use_worktree" == true ]]; then
    git branch "$branch" "$base_ref"
    git config "branch.${branch}.created-by" "$UTPR_CREATED_BY"
    gum_success "Created branch '${branch}' from '${base_ref}'."
    _init_worktree "$branch"
  else
    git switch -c "$branch" "$base_ref"
    git config "branch.${branch}.created-by" "$UTPR_CREATED_BY"
    gum_success "Created branch '${branch}' from '${base_ref}'."
  fi
}

_init_worktree() {
  local branch="$1"
  local repo_root wt_dir
  repo_root="$(git rev-parse --show-toplevel)"
  wt_dir="$(get_worktree_dir "$branch")"

  mkdir -p "$(dirname "$wt_dir")"
  local wt_output
  if ! wt_output="$(git worktree add "$wt_dir" "$branch" 2>&1)"; then
    if [[ -n "$wt_output" ]]; then
      printf '%s\n' "$wt_output" >&2
    fi
    die "Failed to create worktree at ${wt_dir}."
  fi
  gum_success "Created worktree at ${wt_dir}"

  symlink_worktree_dirs "$repo_root" "$wt_dir"
  run_worktree_setup "$wt_dir"

  local editor
  editor="$(auto_detect_editor)"
  if [[ -n "$editor" ]]; then
    open_in_editor "$editor" "$wt_dir" || true
  fi

  gum_info "cd \"${wt_dir}\""
}

_configure_fetched_branch() {
  local local_branch="$1" remote_name="$2" head_ref="$3" pr_url="$4"
  git branch --set-upstream-to="${remote_name}/${head_ref}" "$local_branch" 2>/dev/null || true
  git config "branch.${local_branch}.created-by" "$UTPR_CREATED_BY"
  git config "branch.${local_branch}.pr-url" "$pr_url"
}

cmd_pause() {
  detect_remote_config

  if is_in_worktree; then
    local main_root
    main_root="$(get_main_repo_root)"
    gum_info "You're in a worktree. Main repo is at:"
    gum_info "cd \"${main_root}\""
    return
  fi

  if is_on_default_branch; then
    die "Already on the default branch (${DEFAULT_BRANCH}). Nothing to pause."
  fi

  local current wt_path
  current="$(get_current_branch)"
  wt_path="$(get_branch_worktree_path "$current")"
  if [[ -n "$wt_path" ]]; then
    gum_info "Branch '${current}' has a worktree at: ${wt_path}"
    gum_info "Navigate there to continue working, or use 'utpr forget' to clean up."
    return
  fi

  challenge_uncommitted_changes
  challenge_unpushed_commits
  challenge_branch_behind_remote

  switch_to_branch "$DEFAULT_BRANCH"
  git_spin "Pulling ${DEFAULT_BRANCH}..." git pull "$SOURCE_REMOTE" "$DEFAULT_BRANCH"
  gum_success "Paused '${current}'. Switched to ${DEFAULT_BRANCH}."
}

cmd_resume() {
  detect_remote_config
  local branch

  if [[ $# -gt 0 ]]; then
    branch="$1"
    validate_branch_name "$branch"
  else
    local branches
    branches="$(git for-each-ref --format='%(refname:short)' --sort=-committerdate refs/heads/ | grep -Fxv "$DEFAULT_BRANCH" || true)"

    if [[ -z "$branches" ]]; then
      die "No branches to resume."
    fi

    branch="$(printf '%s\n' "$branches" | gum choose --header "Select a branch to resume:")"
    if [[ -z "$branch" ]]; then
      die "No branch selected."
    fi
  fi

  if ! git show-ref --verify --quiet "refs/heads/${branch}"; then
    die "Branch '${branch}' does not exist locally."
  fi

  local wt_path
  wt_path="$(get_branch_worktree_path "$branch")"
  if [[ -n "$wt_path" ]]; then
    offer_worktree_navigation "$wt_path"
    return
  fi

  challenge_uncommitted_changes
  switch_to_branch "$branch"

  local tracking
  tracking="$(get_tracking_branch)"
  if [[ -n "$tracking" ]]; then
    local pull_output
    if ! pull_output="$(gum spin --title "Pulling from ${tracking}..." --show-error -- git pull 2>&1)"; then
      gum_warn "Pull failed (you may have merge conflicts to resolve)."
      if [[ -n "$pull_output" ]]; then
        printf '%s\n' "$pull_output" >&2
      fi
      exit 1
    fi
  fi

  gum_success "Resumed '${branch}'."
}

cmd_fetch() {
  detect_remote_config

  local use_worktree=false
  local args=()
  local arg
  for arg in "$@"; do
    case "$arg" in
      --worktree) use_worktree=true ;;
      *) args+=("$arg") ;;
    esac
  done
  set -- "${args[@]+"${args[@]}"}"

  local pr_number=""
  if [[ $# -gt 0 ]]; then
    pr_number="$1"
    validate_pr_number "$pr_number"
  else
    local current_user pr_data pr_list="" pr_choice line
    current_user="$(get_gh_login)"
    pr_data="$(gh pr list \
      --json number,title,author,headRefName,isCrossRepository,updatedAt \
      --jq 'sort_by(.updatedAt) | reverse | .[] | [(.number | tostring), .title, .author.login, .headRefName, (.isCrossRepository | tostring)] | @tsv')" || {
      die "Failed to list PRs."
    }

    if [[ -z "$pr_data" ]]; then
      die "No open PRs found."
    fi

    while IFS=$'\t' read -r num title author branch is_fork; do
      line="#${num} ${title} (${author}) [${branch}]"
      [[ "$is_fork" == "true" ]] && line="${line} [fork]"
      [[ -n "$current_user" && "$author" == "$current_user" ]] && line="$(gum style --bold "$line")"
      pr_list="${pr_list}${line}"$'\n'
    done <<< "$pr_data"
    pr_list="${pr_list%$'\n'}"

    pr_choice="$(printf '%s\n' "$pr_list" | gum choose --header "Select a PR to fetch:")"
    if [[ -z "$pr_choice" ]]; then
      die "No PR selected."
    fi

    pr_number="$(parse_pr_number_from_choice "$pr_choice")"
  fi

  local source_repo
  source_repo="$(parse_repo_spec "$(git remote get-url "$SOURCE_REMOTE")")"

  local pr_data
  if ! pr_data="$(gh api "repos/${source_repo}/pulls/${pr_number}" \
    --jq '[.head.ref, .head.repo.full_name, .head.repo.clone_url,
           (if .head.repo.full_name != .base.repo.full_name then "true" else "false" end),
           .head.repo.owner.login, .html_url] | @tsv' 2>&1)"; then
    printf '%s\n' "$pr_data" >&2
    die "Failed to fetch PR #${pr_number} details."
  fi

  local head_ref head_repo_full_name head_repo_clone_url is_fork_pr pr_author pr_url
  IFS=$'\t' read -r head_ref head_repo_full_name head_repo_clone_url is_fork_pr pr_author pr_url <<<"$pr_data"

  local remote_name local_branch
  remote_name="$SOURCE_REMOTE"
  local_branch="$head_ref"

  if [[ "$is_fork_pr" == "true" ]]; then
    remote_name="$pr_author"

    if ! git remote get-url "$remote_name" &>/dev/null; then
      gum_info "Adding remote '${remote_name}' for '${head_repo_full_name}'."
      git remote add "$remote_name" "$head_repo_clone_url"
      git config "remote.${remote_name}.created-by" "$UTPR_CREATED_BY"
    fi

    local_branch="pr-${pr_number}/${head_ref}"
  fi

  git_spin "Fetching '${head_ref}' from ${remote_name}..." \
    git fetch "$remote_name" "$head_ref"

  if [[ "$use_worktree" == true ]]; then
    if git show-ref --verify --quiet "refs/heads/${local_branch}"; then
      # Existing branch — update it in place without checking out
      git fetch . FETCH_HEAD:"${local_branch}" 2>/dev/null || {
        gum_warn "Could not fast-forward '${local_branch}'. You may need to merge manually in the worktree."
      }
    else
      git branch "$local_branch" FETCH_HEAD
    fi

    _configure_fetched_branch "$local_branch" "$remote_name" "$head_ref" "$pr_url"

    gum_success "Fetched PR #${pr_number} → '${local_branch}'."

    local wt_path
    wt_path="$(get_branch_worktree_path "$local_branch")"
    if [[ -n "$wt_path" ]]; then
      gum_info "Branch '${local_branch}' already has a worktree."
      offer_worktree_navigation "$wt_path"
      return
    fi

    _init_worktree "$local_branch"
  else
    if git show-ref --verify --quiet "refs/heads/${local_branch}"; then
      switch_to_branch "$local_branch"
      if ! git merge FETCH_HEAD; then
        gum_warn "Merge had conflicts. Resolve them before continuing."
      fi
    else
      git switch -c "$local_branch" FETCH_HEAD
    fi

    _configure_fetched_branch "$local_branch" "$remote_name" "$head_ref" "$pr_url"

    gum_success "Fetched PR #${pr_number} → '${local_branch}'."
  fi
}

cmd_push() {
  detect_remote_config

  if is_on_default_branch; then
    die "Cannot push from the default branch. Create a PR branch first with 'utpr init'."
  fi

  challenge_uncommitted_changes

  local edit_mode="terminal"
  local arg
  for arg in "$@"; do
    case "$arg" in
      --edit=browser)  edit_mode="browser" ;;
      --edit=terminal) edit_mode="terminal" ;;
      --edit=*)
        die "Unknown edit mode: ${arg#--edit=} (expected 'browser' or 'terminal')"
        ;;
    esac
  done

  local current tracking
  current="$(get_current_branch)"
  tracking="$(get_tracking_branch)"

  if [[ -z "$tracking" ]]; then
    git_spin "Pushing '${current}' to ${PUSH_REMOTE}..." \
      git push -u "$PUSH_REMOTE" HEAD
    gum_success "Pushed '${current}' to ${PUSH_REMOTE}."

    if [[ "$edit_mode" == "browser" ]]; then
      local push_url owner_repo
      push_url="$(git remote get-url "$PUSH_REMOTE")"
      owner_repo="$(parse_repo_spec "$push_url")"
      if [[ "$REMOTE_CONFIG" == "fork" ]]; then
        local source_url source_repo fork_owner
        source_url="$(git remote get-url "$SOURCE_REMOTE")"
        source_repo="$(parse_repo_spec "$source_url")"
        fork_owner="$(printf '%s\n' "$owner_repo" | cut -d/ -f1)"
        open_url "https://github.com/${source_repo}/compare/${DEFAULT_BRANCH}...${fork_owner}:${current}?expand=1"
      else
        open_url "https://github.com/${owner_repo}/compare/${DEFAULT_BRANCH}...${current}?expand=1"
      fi
    else
      local pr_url exit_code=0
      pr_url="$(gh pr create)" || exit_code=$?
      if [[ "$exit_code" -eq 130 ]]; then
        gum_info "Cancelled."
        return 0
      elif [[ "$exit_code" -ne 0 ]]; then
        die "Failed to create pull request."
      fi
      git config "branch.${current}.pr-url" "$pr_url"
      gum_success "PR created: ${pr_url}"
    fi
  else
    local behind
    behind="$(git rev-list --count "HEAD..@{u}" 2>/dev/null || echo 0)"
    if [[ "$behind" -gt 0 ]]; then
      gum_warn "Your branch is ${behind} commit(s) behind the remote."
      gum_warn "Pull first with 'utpr pull'."
      exit 1
    fi

    git_spin "Pushing to ${tracking}..." git push
    gum_success "Pushed to ${tracking}."
  fi
}

cmd_pull() {
  detect_remote_config
  if is_on_default_branch; then
    git_spin "Pulling ${DEFAULT_BRANCH} from ${SOURCE_REMOTE}..." \
      git pull "$SOURCE_REMOTE" "$DEFAULT_BRANCH"
    gum_success "Pulled latest ${DEFAULT_BRANCH}."
  else
    local tracking
    tracking="$(get_tracking_branch)"
    if [[ -z "$tracking" ]]; then
      gum_warn "No tracking branch configured. Nothing to pull."
      return 0
    fi
    git_spin "Pulling from ${tracking}..." git pull
    gum_success "Pulled latest changes."
  fi
}

cmd_merge_main() {
  detect_remote_config

  if is_on_default_branch; then
    die "Already on the default branch. Use 'utpr pull' instead."
  fi

  git_spin "Fetching ${DEFAULT_BRANCH} from ${SOURCE_REMOTE}..." \
    git fetch "$SOURCE_REMOTE" "$DEFAULT_BRANCH"

  local current
  current="$(get_current_branch)"
  gum_info "Merging ${SOURCE_REMOTE}/${DEFAULT_BRANCH} into ${current}..."
  if ! git merge --no-edit "${SOURCE_REMOTE}/${DEFAULT_BRANCH}"; then
    gum_warn "Merge had conflicts. Resolve these files before continuing:"
    local conflicts
    conflicts="$(git diff --name-only --diff-filter=U 2>/dev/null || true)"
    while IFS= read -r f; do
      gum style --foreground 3 "  • ${f}" >&2
    done <<<"$conflicts"
    exit 1
  fi

  gum_success "Merged ${DEFAULT_BRANCH} into ${current}."
}

cmd_forget() {
  if is_in_worktree; then
    die "Navigate to the main repo first. Run: cd \"$(get_main_repo_root)\""
  fi

  detect_remote_config

  local target
  if [[ $# -gt 0 ]]; then
    target="$1"
    validate_branch_name "$target"
    if [[ "$target" == "$DEFAULT_BRANCH" ]]; then
      die "Cannot forget the default branch '${DEFAULT_BRANCH}'."
    fi
    if ! git show-ref --verify --quiet "refs/heads/${target}"; then
      die "Branch '${target}' does not exist locally."
    fi
  elif is_on_default_branch; then
    local branches
    branches="$(git for-each-ref --format='%(refname:short)' --sort=-committerdate refs/heads/ | grep -Fxv "$DEFAULT_BRANCH" || true)"

    if [[ -z "$branches" ]]; then
      die "No branches to forget."
    fi

    local branch_display_list="" wt_path branch
    while IFS= read -r branch; do
      wt_path="$(get_branch_worktree_path "$branch")"
      if [[ -n "$wt_path" ]]; then
        branch_display_list="${branch_display_list}${branch}  [worktree]"$'\n'
      else
        branch_display_list="${branch_display_list}${branch}"$'\n'
      fi
    done <<< "$branches"
    branch_display_list="${branch_display_list%?}"

    local branch_choice
    branch_choice="$(printf '%s\n' "$branch_display_list" | gum choose --header "Select a branch to forget:")" || true
    if [[ -z "$branch_choice" ]]; then
      gum_info "Cancelled."
      return 0
    fi

    target="${branch_choice%  \[worktree\]}"
  else
    target="$(get_current_branch)"
  fi

  local current
  current="$(get_current_branch)"

  if [[ "$target" == "$current" ]]; then
    challenge_uncommitted_changes
  fi
  challenge_local_branch_delete "$target"

  if [[ "$target" == "$current" ]]; then
    if ! gum confirm "Abandon branch '${target}' and switch to ${DEFAULT_BRANCH}?"; then
      gum_info "Cancelled."
      return 0
    fi
    remove_worktree "$target"
    switch_to_branch "$DEFAULT_BRANCH"
    git_spin "Pulling ${DEFAULT_BRANCH}..." git pull "$SOURCE_REMOTE" "$DEFAULT_BRANCH"
  else
    if ! gum confirm "Delete branch '${target}'?"; then
      gum_info "Cancelled."
      return 0
    fi
    remove_worktree "$target"
  fi

  delete_local_branch "$target"
  gum_success "Deleted local branch '${target}'."
  _cleanup_utpr_remote
}

cmd_finish() {
  if is_in_worktree; then
    die "Navigate to the main repo first. Run: cd \"$(get_main_repo_root)\""
  fi

  detect_remote_config

  local pr_number=""

  if [[ $# -gt 0 ]]; then
    pr_number="$1"
    validate_pr_number "$pr_number"
  elif ! is_on_default_branch; then
    pr_number="$(gh pr view --json number --jq '.number' 2>/dev/null || true)"
    if [[ -z "$pr_number" ]]; then
      gum_info "Provide a PR number: utpr finish <pr>"
      die "Could not determine PR number for current branch."
    fi
  else
    local current_user pr_data pr_list="" pr_choice line pr_status
    current_user="$(get_gh_login)"
    pr_data="$(gh pr list --state closed \
      --json number,title,author,mergedAt,updatedAt \
      --jq 'sort_by(.updatedAt) | reverse | .[] | [(.number | tostring), .title, .author.login, (if .mergedAt then "merged" else "closed" end)] | @tsv')" || {
      die "Failed to list closed PRs."
    }

    if [[ -z "$pr_data" ]]; then
      die "No closed PRs found."
    fi

    while IFS=$'\t' read -r num title author pr_status; do
      line="#${num} [${pr_status}] ${title} (${author})"
      [[ -n "$current_user" && "$author" == "$current_user" ]] && line="$(gum style --bold "$line")"
      pr_list="${pr_list}${line}"$'\n'
    done <<< "$pr_data"
    pr_list="${pr_list%$'\n'}"

    pr_choice="$(printf '%s\n' "$pr_list" | gum choose --header "Select a PR to finish:")"
    if [[ -z "$pr_choice" ]]; then
      gum_info "Cancelled."
      return 0
    fi

    pr_number="$(parse_pr_number_from_choice "$pr_choice")"
  fi

  local source_repo pr_data
  source_repo="$(parse_repo_spec "$(git remote get-url "$SOURCE_REMOTE")")"
  if ! pr_data="$(gh api "repos/${source_repo}/pulls/${pr_number}" \
    --jq '[.state, (.merged | tostring), .head.ref, .head.repo.full_name] | @tsv' 2>&1)"; then
    printf '%s\n' "$pr_data" >&2
    die "Failed to fetch PR #${pr_number} details."
  fi

  local pr_state pr_merged pr_branch pr_head_repo
  IFS=$'\t' read -r pr_state pr_merged pr_branch pr_head_repo <<<"$pr_data"

  if [[ "$pr_state" != "closed" ]]; then
    gum_warn "PR #${pr_number} is still open (state: ${pr_state})."
    if ! gum confirm "Continue anyway?"; then
      return 0
    fi
  fi

  if ! gum confirm "Finish PR #${pr_number} (branch: ${pr_branch})?"; then
    gum_info "Cancelled."
    return 0
  fi

  if ! is_on_default_branch; then
    challenge_uncommitted_changes
    switch_to_branch "$DEFAULT_BRANCH"
  fi

  git_spin "Pulling ${DEFAULT_BRANCH}..." git pull "$SOURCE_REMOTE" "$DEFAULT_BRANCH"

  local local_branch=""
  if git show-ref --verify --quiet "refs/heads/${pr_branch}"; then
    local_branch="$pr_branch"
  elif git show-ref --verify --quiet "refs/heads/pr-${pr_number}/${pr_branch}"; then
    local_branch="pr-${pr_number}/${pr_branch}"
  fi

  if [[ -n "$local_branch" ]]; then
    remove_worktree "$local_branch"
    challenge_local_branch_delete "$local_branch"
    delete_local_branch "$local_branch"
    gum_success "Deleted local branch '${local_branch}'."
  else
    gum_info "No local branch found for PR #${pr_number}."
  fi

  if [[ "$pr_merged" == "true" ]]; then
    # Only attempt remote branch deletion if the branch lives in a repo we can push to
    local push_repo
    push_repo="$(parse_repo_spec "$(git remote get-url "$PUSH_REMOTE")")"
    if [[ "$pr_head_repo" == "$push_repo" ]]; then
      local delete_err
      if delete_err="$(gh api --method DELETE "repos/${pr_head_repo}/git/refs/heads/${pr_branch}" 2>&1)"; then
        gum_success "Deleted remote branch '${pr_branch}'."
      elif printf '%s\n' "$delete_err" | grep -q "Reference does not exist"; then
        gum_info "Remote branch '${pr_branch}' already deleted."
      else
        gum_warn "Could not delete remote branch '${pr_branch}' (may require manual cleanup)."
      fi
    else
      gum_info "Remote branch '${pr_branch}' is on '${pr_head_repo}' (not yours). Skipping deletion."
    fi
  fi

  if [[ -n "$local_branch" ]]; then
    _cleanup_utpr_remote
  fi

  gum_success "Finished PR #${pr_number}."
}

cmd_view() {
  detect_remote_config

  local view_mode="comments"
  local pr_arg=""
  local arg
  for arg in "$@"; do
    case "$arg" in
      --web|-w)  view_mode="web" ;;
      --summary) view_mode="summary" ;;
      *)         pr_arg="$arg" ;;
    esac
  done

  local pr_number=""
  if [[ -n "$pr_arg" ]]; then
    validate_pr_number "$pr_arg"
    pr_number="$pr_arg"
  elif ! is_on_default_branch; then
    pr_number="$(gh pr view --json number --jq '.number' 2>/dev/null || true)"
    if [[ -z "$pr_number" ]]; then
      die "No PR found for the current branch."
    fi
  else
    local current_user pr_data pr_list="" pr_choice line
    current_user="$(get_gh_login)"
    pr_data="$(gh pr list \
      --json number,title,author,updatedAt \
      --jq 'sort_by(.updatedAt) | reverse | .[] | [(.number | tostring), .title, .author.login] | @tsv')" || {
      die "Failed to list PRs."
    }

    if [[ -z "$pr_data" ]]; then
      die "No open PRs found."
    fi

    while IFS=$'\t' read -r num title author; do
      line="#${num} ${title} (${author})"
      [[ -n "$current_user" && "$author" == "$current_user" ]] && line="$(gum style --bold "$line")"
      pr_list="${pr_list}${line}"$'\n'
    done <<< "$pr_data"
    pr_list="${pr_list%$'\n'}"

    pr_choice="$(printf '%s\n' "$pr_list" | gum choose --header "Select a PR to view:")"
    if [[ -z "$pr_choice" ]]; then
      gum_info "Cancelled."
      return 0
    fi

    pr_number="$(parse_pr_number_from_choice "$pr_choice")"
  fi

  case "$view_mode" in
    web)
      gh pr view "$pr_number" --web
      ;;
    summary)
      local pr_md
      pr_md="$(gh pr view "$pr_number" \
        --json number,title,body,author,state,labels \
        --jq '"# #\(.number) \(.title)\n\n**Author:** \(.author.login) · **State:** \(.state)\(if (.labels | length) > 0 then (" · **Labels:** " + (.labels | map(.name) | join(", "))) else "" end)\n\n\(if (.body // "") != "" then .body else "*No description provided.*" end)"' \
        2>/dev/null)" || {
        die "Failed to fetch PR #${pr_number}."
      }
      printf '%s\n' "$pr_md" | gum format
      ;;
    *)
      gh pr view "$pr_number" --comments
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Internal helpers
# ---------------------------------------------------------------------------
_cleanup_utpr_remote() {
  local remote created_by tracking_branches

  while IFS= read -r remote; do
    [[ -z "$remote" ]] && continue
    created_by="$(git config "remote.${remote}.created-by" 2>/dev/null || true)"
    if [[ "$created_by" != "$UTPR_CREATED_BY" ]]; then
      continue
    fi

    tracking_branches="$(git for-each-ref --format='%(upstream:short)' refs/heads/ | awk -v p="${remote}/" 'index($0, p) == 1' || true)"

    if [[ -z "$tracking_branches" ]]; then
      gum_info "Removing unused remote '${remote}'."
      git remote remove "$remote"
    fi
  done < <(git remote)
}

# ---------------------------------------------------------------------------
# Main entry point
# ---------------------------------------------------------------------------
main() {
  if [ "$#" -eq 0 ]; then
    show_help
    exit 0
  fi

  case "$1" in
    --help | -h)
      show_help
      exit 0
      ;;
    --version | -v)
      echo "utpr ${VERSION}"
      exit 0
      ;;
  esac

  local cmd="$1"
  shift

  # Check for --help in remaining args before dispatching
  local arg
  for arg in "$@"; do
    if [ "${arg}" = "--help" ] || [ "${arg}" = "-h" ]; then
      show_command_help "${cmd}"
      exit 0
    fi
  done

  ensure_git_repo
  check_dependencies

  case "${cmd}" in
    init)        cmd_init "$@" ;;
    pause)       cmd_pause "$@" ;;
    resume)      cmd_resume "$@" ;;
    fetch)       cmd_fetch "$@" ;;
    push)        cmd_push "$@" ;;
    pull)        cmd_pull "$@" ;;
    merge-main)  cmd_merge_main "$@" ;;
    forget)      cmd_forget "$@" ;;
    finish)      cmd_finish "$@" ;;
    view)        cmd_view "$@" ;;
    *)
      echo >&2
      show_help
      die "Unknown command: ${cmd}"
      ;;
  esac
}

main "$@"
